#!/usr/bin/env bash
# The only applied playbook uses a disposable home; live machines are untouched.
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_dir"
export ANSIBLE_CONFIG="$repo_dir/ansible.cfg"
export PATH="$repo_dir/.venv/bin:$PATH"
sandbox=$(mktemp -d)
trap 'rm -rf "$sandbox"' EXIT
mkdir "$sandbox/home"
printf 'keep this original\n' > "$sandbox/original"
ln -s "$sandbox/original" "$sandbox/home/.zshrc"

bash -n bootstrap dotfiles scripts/github-key tests/run
zsh -n shell/zshrc
if command -v shellcheck >/dev/null; then
    shellcheck bootstrap dotfiles scripts/github-key tests/run scripts/setup-hirayama.sh
fi
python -m unittest discover -s tests -p 'test_*.py'
# Exercise argument handling without making SSH connections, including macOS Bash 3.2.
./dotfiles check bagheera --batch --list-hosts
./dotfiles capture servers --batch --list-hosts
for playbook in site check capture; do
    ansible-playbook "playbooks/$playbook.yml" --syntax-check
done
ansible-playbook tests/render.yml -e "render_dir=$sandbox"
if command -v testparm >/dev/null; then
    testparm -s "$sandbox/bagheera-smb.conf" >/dev/null
    testparm -s "$sandbox/hirayama-smb.conf" >/dev/null
fi
ansible-playbook tests/user.yml -e "sandbox_home=$sandbox/home"
ansible-playbook tests/user.yml -e "sandbox_home=$sandbox/home" > "$sandbox/second-run.log"
cat "$sandbox/second-run.log"
grep -Eq 'changed=0[[:space:]]' "$sandbox/second-run.log"
test ! -L "$sandbox/home/.zshrc"
cmp "$sandbox/original" "$sandbox/home/.zshrc.before-dotfiles"
test "$(cat "$sandbox/original")" = 'keep this original'
zsh -f -c 'source "$1/.config/dotfiles/host.zsh"; [[ $DOTFILES_PROMPT_COLOR == 208 ]]' zsh "$sandbox/home"
printf '\nUser restore is repeatable; the original link target and contents survived.\n'
