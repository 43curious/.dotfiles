[Unit]
Description=Bagheera's Jellyfin and qBittorrent containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/copper

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ dotfiles_home }}
ExecStartPre=/usr/bin/findmnt -rn -M /srv/copper -S UUID={{ dotfiles_mounts | selectattr('name', 'equalto', 'copper') | map(attribute='uuid') | first }}
ExecStart=/usr/bin/docker compose -f {{ dotfiles_home }}/compose.yaml up -d --pull missing
ExecReload=/usr/bin/docker compose -f {{ dotfiles_home }}/compose.yaml up -d --pull missing
ExecStop=/usr/bin/docker compose -f {{ dotfiles_home }}/compose.yaml stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
