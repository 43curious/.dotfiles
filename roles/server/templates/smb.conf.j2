# Managed by dotfiles. Keep passwords in your password manager.
[global]
    workgroup = WORKGROUP
    netbios name = {{ inventory_hostname }}
    server string = {{ inventory_hostname }}
    server role = standalone server
    security = user
    map to guest = never
    server min protocol = SMB2
    smb ports = 445
    load printers = no
    disable spoolss = yes
    vfs objects = catia fruit streams_xattr
    fruit:aapl = yes
    fruit:model = Xserve
    fruit:metadata = stream

{% for share in dotfiles_shares %}
[{{ share.name }}]
    path = {{ share.path }}
    browseable = yes
    read only = no
    guest ok = no
    valid users = {{ dotfiles_user }}
    veto files = /lost+found/
    create mask = {{ dotfiles_smb_create_mask }}
    directory mask = {{ dotfiles_smb_directory_mask }}
    root preexec = /usr/bin/findmnt -rn -M {{ share.mount }} -S UUID={{ share.uuid }}
    root preexec close = yes

{% endfor %}
