# Restore applications missing from /Applications. Existing installations,
# including those installed by IT, remain under their current ownership.
# This Brewfile is additive: do not use it with brew bundle cleanup.
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace" unless File.exist?("/Applications/AeroSpace.app")
cask "ghostty" unless File.exist?("/Applications/Ghostty.app")
cask "tailscale-app" unless File.exist?("/Applications/Tailscale.app")
cask "zen" unless File.exist?("/Applications/Zen.app")
