# Shared interactive shell; profiles supply only the differences between machines.
typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/bin" /usr/local/bin $path)
[[ -x /opt/homebrew/bin/brew ]] && path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
[[ -d "$HOME/.config/composer/vendor/bin" ]] && path+=("$HOME/.config/composer/vendor/bin")
[[ -d "$HOME/.antigravity/antigravity/bin" ]] && path+=("$HOME/.antigravity/antigravity/bin")
export PATH

[[ -r "$HOME/.config/dotfiles/host.zsh" ]] && source "$HOME/.config/dotfiles/host.zsh"
if [[ -z ${DOTFILES_PROMPT_COLOR:-} ]]; then
  case ${HOST%%.*} in
    bagheera) DOTFILES_PROMPT_COLOR=177 ;;
    hirayama) DOTFILES_PROMPT_COLOR=208 ;;
    *) DOTFILES_PROMPT_COLOR=14 ;;
  esac
fi

HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt AUTO_CD HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

autoload -Uz compinit
compinit
bindkey -e
bindkey '^[[A' up-line-or-history
bindkey '^[[B' down-line-or-history
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

alias l='ls -l'
alias ll='ls -lh'
alias la='ls -lAh'
alias ..='cd ..'
alias ...='cd ../..'
[[ $OSTYPE == linux* ]] && alias ls='ls --color=auto'

# Keep the Mac's plugins; a plain zsh installation works without them.
if [[ $OSTYPE == darwin* && -r "$HOME/.oh-my-zsh/oh-my-zsh.sh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  plugins=(zsh-syntax-highlighting zsh-autosuggestions)
  source "$ZSH/oh-my-zsh.sh"
fi

autoload -U colors && colors
autoload -Uz vcs_info add-zsh-hook
setopt PROMPT_SUBST
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats '%b'

# Preserve the familiar clean-gray / dirty-red branch status on every machine.
_dotfiles_precmd() {
  vcs_info
  local branch=${vcs_info_msg_0_//\%/%%}
  if [[ -z $branch ]]; then
    git_prompt=''
  elif [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
    git_prompt=" %F{9}${branch}%f"
  else
    git_prompt=" %F{8}${branch}%f"
  fi
}
add-zsh-hook precmd _dotfiles_precmd
PROMPT='%F{${DOTFILES_PROMPT_COLOR}}%~%f${git_prompt}
%F{${DOTFILES_PROMPT_COLOR}}❯%f '

# Edit the Brewfile, update Homebrew, then reconcile installed packages.
function brewsync() {
    local brewfile="$HOME/.dotfiles/brewfile"
    [[ -f "$brewfile" ]] || brewfile="$HOME/.Brewfile"

    if [[ ! -f "$brewfile" ]]; then
        print -u2 -- "Error: Brewfile no encontrado: $brewfile"
        return 1
    fi

    nvim "$brewfile" || return
    brew update || return
    brew bundle install --upgrade --file="$brewfile" || return

}

# Copy CZM2's contents to Bagheera over SSH; pass --dry-run to preview.
function pewtersync() {
    local source_dir="/Volumes/CZM2"
    local rsync_bin=rsync

    if [[ ! -d "$source_dir" || "$(/sbin/mount)" != *" on $source_dir ("* ]]; then
        print -u2 -- "Error: CZM2 is not mounted at $source_dir"
        return 1
    fi

    # Prefer Homebrew rsync over Apple's older bundled version.
    if [[ -x /opt/homebrew/bin/rsync ]]; then
        rsync_bin=/opt/homebrew/bin/rsync
    elif [[ -x /usr/local/bin/rsync ]]; then
        rsync_bin=/usr/local/bin/rsync
    fi

    "$rsync_bin" -ah --no-owner --no-group --itemize-changes \
        --partial-dir=.rsync-partial --progress \
        --exclude='/.DocumentRevisions-V100*/' \
        --exclude='/.Spotlight-V100/' \
        --exclude='/.TemporaryItems/' \
        --exclude='/.Trashes/' \
        --exclude='/.fseventsd/' \
        --exclude='.DS_Store' \
        "$@" -- "$source_dir/" "jon@bagheera:/srv/pewter/"
}

#Alias
alias bagheera="ssh jon@bagheera"


export BUN_INSTALL="$HOME/.bun"
[[ -d "$BUN_INSTALL/bin" ]] && path=("$BUN_INSTALL/bin" $path)
[[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
[[ -n ${REX_BIN_DIR:-} ]] && path=("$REX_BIN_DIR" $path)
[[ -r "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
